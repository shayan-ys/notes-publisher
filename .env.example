# Copy to .env (or .env.tpl if you use 1Password's `op run`) and fill in.
#
# notes-publisher reads its site-specific config from the environment so the
# same package can publish to different sites / accounts without forking.

# Required — the public domain where your notes are served.
# Each published page lives at https://${NOTES_DOMAIN}/<slug>/.
NOTES_DOMAIN=notes.example.com

# Required — the GitHub repo your content lives in. `publish.py` expects a
# clone of this repo at `.pipeline/repo/` (clone it once with the URL below).
# Used by .pipeline/repo's git remote and by error hints.
NOTES_CONTENT_REPO=git@github.com:you/your-notes-content.git

# Optional — if your content repo is private and you push via HTTPS, set a
# fine-grained PAT here. Not used by the package itself; this is only for the
# git operation inside `publish.py`. With SSH + a key in your agent, leave
# unset.
# GITHUB_TOKEN=
